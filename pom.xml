<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 3.5.x (Java 21). Si tu IDE sugiere un parche mas nuevo de 3.5.x, subelo: es compatible. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>pe.sfe</groupId>
    <artifactId>sfe-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SFE Grupo 4 - Sistema de Facturacion Electronica (SUNAT)</name>
    <description>Monolito modular: sfe-api + sfe-worker sobre sfe-core / sfe-persistence</description>

    <modules>
        <module>sfe-core</module>
        <module>sfe-persistence</module>
        <module>sfe-api</module>
        <module>sfe-worker</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- WSS4J 3.0.x es la linea jakarta que usa Spring-WS 4.x. Verifica la version contra la que traiga tu spring-ws-security. -->
        <wss4j.version>3.0.4</wss4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>pe.sfe</groupId>
                <artifactId>sfe-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pe.sfe</groupId>
                <artifactId>sfe-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.wss4j</groupId>
                <artifactId>wss4j-ws-security-dom</artifactId>
                <version>${wss4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>-Dfile.encoding=UTF-8</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
