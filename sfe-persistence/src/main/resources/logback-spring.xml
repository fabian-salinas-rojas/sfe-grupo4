<?xml version="1.0" encoding="UTF-8"?>
<!-- Ninguna credencial (Clave SOL, contrasena de certificado, API Key, token WS-Security) debe llegar a un log.
     El codigo ya evita registrarlas (clase Secret); este conversor enmascara cualquier rastro residual. -->
<configuration>
    <conversionRule conversionWord="msgm" converterClass="pe.sfe.persistence.log.MaskedMessageConverter"/>
    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p [%thread] %logger{36} - %msgm%n%ex</pattern>
        </encoder>
    </appender>
    <logger name="org.springframework.ws.client.MessageTracing" level="INFO"/>
    <logger name="org.springframework.ws.server.MessageTracing" level="INFO"/>
    <logger name="org.apache.wss4j" level="WARN"/>
    <logger name="org.apache.xml.security" level="WARN"/>
    <root level="INFO"><appender-ref ref="CONSOLA"/></root>
</configuration>